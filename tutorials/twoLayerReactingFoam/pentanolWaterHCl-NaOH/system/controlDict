FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     twoLayerReactingFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         4311;           // t* = 10, t* = t*DA/h^2

deltaT          0.01;
adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       0.5;

writeControl    adjustableRunTime;
writeInterval   431.1;          // t* = 1
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;

