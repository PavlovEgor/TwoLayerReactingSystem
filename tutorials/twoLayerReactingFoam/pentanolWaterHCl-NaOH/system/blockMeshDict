FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// H = 80 h, L = 40 h, h = 1.2 mm: 48 x 96 mm, the mesh of the paper.

scale   1;

L       0.048;
Hhalf   0.048;
mHhalf  -0.048;
depth   0.0012;

nx      200;
ny      400;

vertices
(
    (0    $mHhalf 0)
    ($L   $mHhalf 0)
    ($L   $Hhalf 0)
    (0    $Hhalf 0)
    (0    $mHhalf $depth)
    ($L   $mHhalf $depth)
    ($L   $Hhalf $depth)
    (0    $Hhalf $depth)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny 1) simpleGrading (1 1 1)
);

boundary
(
    walls
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

