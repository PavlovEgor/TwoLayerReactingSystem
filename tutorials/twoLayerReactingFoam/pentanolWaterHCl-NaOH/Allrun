#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# SW regime of the paper, gamma = 0.4, figure 4b (t* = 10 is 4311 s).
# Usage: [NPROCS=N] ./Allrun
#------------------------------------------------------------------------------

nProcs="${NPROCS:-$(getNumberOfProcessors)}"

restore0Dir
runApplication blockMesh
runApplication setTwoLayerFields

if [ "$nProcs" -gt 1 ]
then
    sed -i "s/^numberOfSubdomains.*/numberOfSubdomains  $nProcs;/" system/decomposeParDict
    runApplication decomposePar
    runParallel $(getApplication)
    runApplication reconstructPar
else
    runApplication $(getApplication)
fi

#------------------------------------------------------------------------------
